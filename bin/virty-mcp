#!/usr/bin/env python3
"""Start Virty's local stdio MCP adapter without shell/network indirection."""
import os
from pathlib import Path
import shutil
import sys

ROOT = Path(__file__).resolve().parents[1]
if sys.argv[1:] == ["--help"]:
    print("""Usage: virty-mcp

Start the local stdio MCP server for named macOS / ARM64 Linux VMs.
Stdout is MCP protocol only; use an MCP client, not an interactive terminal.
Images are native PNG content, input uses frame generations, and credentials
are invoked only by opaque alias. Includes VM creation jobs and registry,
power, startup-policy and installer controls. Unregister retains VM data.

Setup: npm ci --ignore-scripts in the Virty checkout (Node 20+ required).
Codex: codex mcp add virty -- /absolute/path/to/bin/virty-mcp
Set tool_timeout_sec = 120 in this server's Codex configuration.
See docs/mcp.md for the tool inventory and workflow.""")
    raise SystemExit(0)
if len(sys.argv) != 1:
    raise SystemExit("Usage: virty-mcp [--help]")
node = shutil.which("node")
if not node:
    node = next((path for path in ("/opt/homebrew/bin/node", "/usr/local/bin/node") if Path(path).is_file()), None)
if not node:
    raise SystemExit("Virty MCP needs Node 20+; install Node and run npm ci --ignore-scripts in the checkout.")
if not (ROOT / "node_modules/@modelcontextprotocol/server").is_dir():
    raise SystemExit("Virty MCP dependencies are missing; run npm ci --ignore-scripts in " + str(ROOT))
os.execv(node, [node, str(ROOT / "MCP/server.mjs")])
